# Copy to .env (gitignored) and set the real values.
DATABASE_URL=postgresql://biswa:CHANGE_ME@127.0.0.1:5432/probehub
HUB_HOST=127.0.0.1
HUB_PORT=8100
# Optional. Leave it unset/empty for an OPEN endpoint (no auth). If set, probes must send it as "Authorization: Bearer <token>". Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
#HUB_API_TOKEN=
# Max request body in bytes (default 1048576 = 1 MiB). Raise it when photos are added.
HUB_MAX_BODY_BYTES=1048576
